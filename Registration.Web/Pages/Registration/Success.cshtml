@page
@model Registration.Web.Pages.RegistrationSuccessModel
@{
    ViewData["Title"] = "Registration Successful";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Registration Successful!</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h5 class="card-title text-center">Thank you for registering with us!</h5>
                    <p class="card-text text-center">Your registration has been submitted successfully and is now pending verification.</p>
                    
                    <div class="alert alert-info">
                        <p class="mb-0"><strong>Registration ID:</strong> <span id="registration-id">@Model.RegistrationId</span></p>
                    </div>
                    
                    <p>What happens next?</p>
                    <ol>
                        <li>Our team will review your submitted information</li>
                        <li>You may be contacted for additional documentation if needed</li>
                        <li>Once verified, you will receive a confirmation email</li>
                        <li>You can track your verification status in your dashboard</li>
                    </ol>
                    
                    <div class="text-center mt-4">
                        <a href="/Dashboard" class="btn btn-primary">Go to Dashboard</a>
                        <a href="/" class="btn btn-outline-secondary ms-2">Return to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
