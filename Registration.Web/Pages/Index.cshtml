@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4 mb-4">Subcontractor Registration Portal</h1>
    <p class="lead">Welcome to the subcontractor registration and verification system.</p>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">New Subcontractor?</h5>
                <p class="card-text">Register your business, equipment, drivers, and insurance information to join our network of verified subcontractors.</p>
                <a href="/Registration" class="btn btn-primary">Start Registration</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Already Registered?</h5>
                <p class="card-text">Access your dashboard to manage your equipment, drivers, documents, and track your verification status.</p>
                <a href="/Dashboard" class="btn btn-outline-primary">Go to Dashboard</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Registration Process</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 text-center mb-3">
                        <div class="bg-light rounded-circle p-3 d-inline-block mb-2">
                            <i class="bi bi-building fs-2 text-primary"></i>
                        </div>
                        <h6>1. Business Information</h6>
                        <p class="small">Register your business details</p>
                    </div>
                    <div class="col-md-3 text-center mb-3">
                        <div class="bg-light rounded-circle p-3 d-inline-block mb-2">
                            <i class="bi bi-truck fs-2 text-primary"></i>
                        </div>
                        <h6>2. Equipment Verification</h6>
                        <p class="small">Add your equipment details</p>
                    </div>
                    <div class="col-md-3 text-center mb-3">
                        <div class="bg-light rounded-circle p-3 d-inline-block mb-2">
                            <i class="bi bi-person-badge fs-2 text-primary"></i>
                        </div>
                        <h6>3. Driver Documentation</h6>
                        <p class="small">Register your drivers</p>
                    </div>
                    <div class="col-md-3 text-center mb-3">
                        <div class="bg-light rounded-circle p-3 d-inline-block mb-2">
                            <i class="bi bi-shield-check fs-2 text-primary"></i>
                        </div>
                        <h6>4. Insurance Verification</h6>
                        <p class="small">Upload insurance documents</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
